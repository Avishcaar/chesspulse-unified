# ==============================================================================
# ChessPulse Unified Deployment - Environment Variables
# ==============================================================================
# When deploying to Render, set these variables in the Render Dashboard:
# Dashboard -> Your Web Service -> Environment -> Add Environment Variable
# ==============================================================================

# Core Server Configuration
PORT=10000
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chesspulse?retryWrites=true&w=majority

# Authentication Secrets (Generate secure random 64-char strings)
JWT_SECRET=your_super_secret_jwt_access_key
JWT_EXPIRES_IN=3h
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_key
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_SECRET=your_express_session_secret_key

# Frontend URL (Optional in unified production as backend and frontend share origin)
# FRONTEND_URL=https://chesspulse.onrender.com

# External AI Engine (Optional - used for AI coach / bot commentary if enabled)
GROQ_API_KEY=gsk_your_groq_api_key

# Google OAuth (Optional - only required if Google login is enabled)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://<your-render-app-name>.onrender.com/api/oauth/google/callback
